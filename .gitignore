.godot/
.tools/
.runtime/
*.tmp
*.log
_tmp_*

# Derived map artifacts. build_map.py clears the scene and rebuilds the .blend
# from banilad_osm.json every run, so committing it would store a fresh ~9 MB
# blob on each map iteration for no recoverable value. The inputs
# (build_map.py, fetch_osm.py, banilad_osm.json) are tracked instead.
banilad_map/*.blend
banilad_map/*.blend1
# Staging copy of the export; the shipped one lives in assets/maps/.
banilad_map/export/
# Per-tile Overpass responses. fetch_osm.py caches each tile here so re-pulling
# one district does not re-pull the whole city; the merged banilad_osm.json is
# the tracked input.
banilad_map/.osm_cache/

# Python bytecode from the shared pipeline modules (geo.py, districts.py).
__pycache__/
*.pyc

# Editor/session scratch
captures/

# Preview renders from render_preview.py / render_all.py. Regenerated on demand
# (out = HERE / "preview_{name}.png"); same throwaway category as captures/.
banilad_map/preview_*.png
